[Unit]
Description=EasyTier Node Monitor Service
Documentation=https://github.com/your-repo/easytier
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USERNAME
Group=YOUR_GROUP
WorkingDirectory=/path/to/monitor
Environment="PATH=/usr/bin:/usr/local/bin"

# 启动命令 - 请修改以下参数
ExecStart=/usr/bin/python3 /path/to/monitor/Monitor.py \
    https://your-api.workers.dev \
    your_jwt_token_here \
    --log-level INFO

# 重启策略
Restart=always
RestartSec=10
StartLimitInterval=200
StartLimitBurst=5

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=easytier-monitor

# 安全设置
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
